# Copiar a .env y cambiar los valores. El archivo .env nunca se sube al repo.

# Usar solo letras y números para no romper la cadena de conexión.
POSTGRES_PASSWORD=cambiar_esta_clave

# Administrador inicial. La contraseña necesita 10 caracteres, mayúscula, minúscula y número.
ADMIN_EMAIL=admin@ejemplo.test
ADMIN_PASSWORD=CambiarEstaClave1

# Dirección y puerto publicados. 127.0.0.1 solo permite entrar desde la misma máquina.
APP_BIND=127.0.0.1
APP_PORT=8080

# Tamaño máximo por imagen.
MAX_UPLOAD_MB=10

# Poner true solo si la app queda detrás de un proxy HTTPS de confianza.
TRUST_PROXY=false
