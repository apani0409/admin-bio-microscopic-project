<MudDialog>
    <DialogContent>
        <form id="user-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <MudStack Spacing="3" Style="min-width: min(420px, 75vw);">
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
                <MudTextField T="string" @bind-Value="_email" Label="Correo" InputType="InputType.Email"
                              Variant="Variant.Outlined" Immediate="true" Required="true" />
                <MudTextField T="string" @bind-Value="_password" Label="Contraseña inicial" InputType="InputType.Password"
                              HelperText="Mínimo 10 caracteres, con mayúscula, minúscula y número."
                              Variant="Variant.Outlined" Immediate="true" Required="true" />
            </MudStack>
        </form>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="user-form" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(_saving || string.IsNullOrWhiteSpace(_email) || string.IsNullOrEmpty(_password))">
            Crear
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private IUserService Users { get; set; } = null!;

    private string? _email;
    private string? _password;
    private string? _error;
    private bool _saving;

    private async Task SubmitAsync()
    {
        if (_saving || string.IsNullOrWhiteSpace(_email) || string.IsNullOrEmpty(_password)) return;

        _saving = true;
        _error = null;
        try
        {
            await Users.CreateReaderAsync(_email.Trim(), _password);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo crear el usuario. Intentá de nuevo.";
        }
        finally
        {
            _saving = false;
        }
    }
}
