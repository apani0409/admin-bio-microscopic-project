@inject CookieAuthStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<AuthorizeView Context="authState">
    <Authorized>
        <MudText Typo="Typo.body2" Class="d-none d-md-flex ml-4 mr-2">@authState.User.Identity?.Name</MudText>
        <MudTooltip Text="Cerrar sesión">
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                           aria-label="Cerrar sesión" OnClick="LogoutAsync" />
        </MudTooltip>
    </Authorized>
</AuthorizeView>

@code {
    private async Task LogoutAsync()
    {
        try
        {
            await AuthState.LogoutAsync();
            Nav.NavigateTo("/login", replace: true);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo cerrar la sesión en el servidor.", Severity.Error);
        }
    }
}
