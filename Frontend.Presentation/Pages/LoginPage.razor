@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@inject CookieAuthStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Iniciar sesión</PageTitle>

<MudPaper Elevation="3" Class="pa-8" Style="width: 100%;">
    <div class="d-flex justify-center mb-4">
        <img src="images/ucr-logo.png" alt="Universidad de Costa Rica" style="max-width: 170px; width: 100%;" />
    </div>
    <MudText Typo="Typo.h5" Align="Align.Center">Colección de microscopía</MudText>
    <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6">Escuela de Biología</MudText>

    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
        <MudStack Spacing="4">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
            <MudTextField T="string" @bind-Value="_email" Label="Correo" InputType="InputType.Email"
                          Variant="Variant.Outlined" Immediate="true" Required="true" />
            <MudTextField T="string" @bind-Value="_password" Label="Contraseña" InputType="InputType.Password"
                          Variant="Variant.Outlined" Immediate="true" Required="true" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Disabled="@(_submitting || !CanSubmit)">
                @(_submitting ? "Entrando..." : "Entrar")
            </MudButton>
        </MudStack>
    </form>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? RequestedReturnUrl { get; set; }

    private string? _email;
    private string? _password;
    private string? _error;
    private bool _submitting;

    private bool CanSubmit => !string.IsNullOrWhiteSpace(_email) && !string.IsNullOrEmpty(_password);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo(ReturnUrl.Sanitize(RequestedReturnUrl), replace: true);
        }
    }

    private async Task SubmitAsync()
    {
        if (_submitting || !CanSubmit) return;

        _submitting = true;
        _error = null;
        try
        {
            if (await AuthState.LoginAsync(_email!.Trim(), _password!))
            {
                Nav.NavigateTo(ReturnUrl.Sanitize(RequestedReturnUrl), replace: true);
                return;
            }

            _password = null;
            _error = "Correo o contraseña incorrectos.";
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con el servidor. Intentá de nuevo.";
        }
        finally
        {
            _submitting = false;
        }
    }
}
