<Router AppAssembly="@typeof(App).Assembly"
        AdditionalAssemblies="@(new[] { typeof(UCR.EB.BioMicroscopeAdmin.Frontend.Presentation.Layout.MainLayout).Assembly })">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData"
                            DefaultLayout="@typeof(UCR.EB.BioMicroscopeAdmin.Frontend.Presentation.Layout.MainLayout)">
            <Authorizing>
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            </Authorizing>
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(UCR.EB.BioMicroscopeAdmin.Frontend.Presentation.Layout.MainLayout)">
            <MudText>Página no encontrada.</MudText>
        </LayoutView>
    </NotFound>
</Router>
